#!/bin/sh

# Reconcile one book's KOReader annotations with the native Kindle sidecar.
# The attached V2 agent removes the private payload after opening it. This
# helper only performs bounded fallback cleanup after the agent/result window.

set -u

JAVA_BIN="/usr/java/bin/java"
PLUGIN_DIR="/mnt/us/koreader/plugins/goodreads.koplugin"
AGENT_JAR="$PLUGIN_DIR/bin/goodreads-annotation-agent-v15.jar"
LAUNCHER_CLASSES="$PLUGIN_DIR/bin/classes"
STATE_DIR="/mnt/us/koreader/settings/goodreads_native_annotations"
LOCK_DIR="/tmp/goodreads-annotation-sync.lock"
PUBLISHED_RESULT="/tmp/goodreads-annotation-result.log"
ATTACH_LOG="/tmp/goodreads-annotation-attach.log"
ANNOTATION_CONTROLLER="com.lab126.KPPAnnotationController"
ANNOTATION_ENQUEUE_PROPERTY="KSDKAnnotationsEnqueueForSync"
SHADOW_SYNC_CONTROLLER="com.lab126.CVMShadowModeManager"
LEGACY_SYNC_PROPERTY="KPPACShadowModeManagerShouldSyncLegacySidecarAndJournal"
KSDK_SHADOW_SYNC_PROPERTY="KPPACShadowModeManagerShouldSyncKSDKAnnotations"
WHISPERSYNC_CONTROLLER="com.lab126.whispersync"
WHISPERSYNC_START_PROPERTY="startSync"
LIPC_SET_PROP="/usr/bin/lipc-set-prop"
LIPC_PROBE="/usr/bin/lipc-probe"
lock_acquired=0
state_temp=""
request_result=""

if [ "$#" -ne 1 ]; then
    exit 2
fi

payload="$1"
case "$payload" in
    /tmp/goodreads-annotations-[0-9]*.properties) ;;
    *) exit 2 ;;
esac

cleanup() {
    # AttachLauncher may return before agentmain starts. This is deliberately
    # reached only after the bounded result wait, never immediately after load.
    rm -f "$payload"
    if [ -n "$request_result" ]; then
        rm -f "$request_result"
    fi
    if [ -n "$state_temp" ]; then
        rm -f "$state_temp"
    fi
    if [ "$lock_acquired" -eq 1 ]; then
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
}
trap cleanup EXIT HUP INT TERM

if [ ! -f "$payload" ] || [ ! -x "$JAVA_BIN" ] || [ ! -r "$AGENT_JAR" ] \
    || [ ! -r "$LAUNCHER_CLASSES/AttachLauncher.class" ]; then
    exit 3
fi

asin="$(sed -n 's/^asin=//p' "$payload" | sed -n '1p')"
request_id="$(sed -n 's/^request_id=//p' "$payload" | sed -n '1p')"
if ! printf '%s\n' "$asin" | grep -Eq '^B[A-Z0-9]{9}$'; then
    exit 2
fi
case "$request_id" in
    ''|*[!0-9]*) exit 2 ;;
esac
request_result="/tmp/goodreads-annotation-result-$request_id.log"

if ! mkdir -p "$STATE_DIR"; then
    exit 4
fi
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    exit 75
fi
lock_acquired=1

framework_pid="$(
    ps -eo pid,args 2>/dev/null \
        | awk '/ch.ethz.iks.concierge.framework.Framework/ && !/awk/ { print $1; exit }'
)"
case "$framework_pid" in
    ''|*[!0-9]*) exit 5 ;;
esac
framework_uid="$(awk '/^Uid:/ { print $2; exit }' "/proc/$framework_pid/status" 2>/dev/null)"
framework_gid="$(awk '/^Gid:/ { print $2; exit }' "/proc/$framework_pid/status" 2>/dev/null)"
case "$framework_uid:$framework_gid" in
    *[!0-9:]*|:|:*|*:) exit 5 ;;
esac

state_file="$STATE_DIR/$asin"
state_temp="$state_file.$$"
if ! grep -Fqx 'agent_generation=15' "$state_file" 2>/dev/null; then
    if ! printf '%s\n' \
        'repair_zero_endpoint=true' \
        'purge_legacy_cloud=true' \
        'force_cloud_replay=true' >>"$payload"; then
        exit 8
    fi
fi
if ! awk -F= '
    BEGIN { print "agent_generation=15" }
    /^desired\.[0-9]+\.start=/ {
        key=$1; sub(/\.start$/, "", key); start[key]=$2
    }
    /^desired\.[0-9]+\.end=/ {
        key=$1; sub(/\.end$/, "", key); finish[key]=$2
    }
    /^desired\.[0-9]+\.note_hex=/ {
        key=$1; sub(/\.note_hex$/, "", key); note[key]=($2 == "" ? "0" : "1")
    }
    END {
        for (key in start) {
            if (finish[key] != "") print start[key] ":" finish[key] ":" note[key]
        }
    }
' "$payload" >"$state_temp"; then
    exit 8
fi
chmod 0600 "$state_temp"

if [ -x "$LIPC_PROBE" ] \
    && "$LIPC_PROBE" "$ANNOTATION_CONTROLLER" 2>/dev/null \
        | grep -Fq 'annotationsDualWriteToKSDK'; then
    printf '%s\n' 'ksdk_dualwrite_available=true' >>"$payload"
else
    printf '%s\n' 'ksdk_dualwrite_available=false' >>"$payload"
fi

# KOReader and this helper run as root, but Amazon's framework JVM runs under a
# firmware-specific account. Resolve its numeric identity from /proc instead of
# assuming passwd/group names. Java reports EACCES here as FileNotFoundException,
# which otherwise looks like an attach timing failure.
if ! chown "$framework_uid:$framework_gid" "$payload" || ! chmod 0600 "$payload"; then
    exit 9
fi

# ShadowModeManager consults these session flags while the native book is
# being written and closed. Setting them after agentmain returns is too late:
# WhisperStore accepts the journal edit, but KPP does not schedule its upload.
if [ ! -x "$LIPC_SET_PROP" ] \
    || ! "$LIPC_SET_PROP" "$SHADOW_SYNC_CONTROLLER" "$LEGACY_SYNC_PROPERTY" 1 \
        >/dev/null 2>&1 \
    || ! "$LIPC_SET_PROP" "$SHADOW_SYNC_CONTROLLER" "$KSDK_SHADOW_SYNC_PROPERTY" 1 \
        >/dev/null 2>&1; then
    exit 9
fi

rm -f "$request_result"
if ! "$JAVA_BIN" --add-modules jdk.attach \
    -cp "$LAUNCHER_CLASSES" \
    AttachLauncher "$framework_pid" "$AGENT_JAR" "$payload" \
    >"$ATTACH_LOG" 2>&1; then
    exit 6
fi

# Some Kindle JVM builds acknowledge loadAgent before agentmain has opened its
# argument file. Keep the private payload alive until the matching result is
# complete; otherwise the EXIT trap can remove it underneath the agent.
result_attempt=0
while [ "$result_attempt" -lt 90 ]; do
    if [ -f "$request_result" ] \
        && grep -Fqx "asin=$asin" "$request_result" \
        && grep -Fqx "request_id=$request_id" "$request_result" \
        && grep -Eq '^success=(true|false)$' "$request_result"; then
        break
    fi
    result_attempt=$((result_attempt + 1))
    sleep 1
done

if ! grep -Fqx "asin=$asin" "$request_result" \
    || ! grep -Fqx "request_id=$request_id" "$request_result"; then
    exit 7
fi

enqueue_ok=0
if grep -Fqx 'success=true' "$request_result" \
    && grep -Fqx 'local_verified=true' "$request_result" \
    && grep -Fqx 'native_notified=true' "$request_result" \
    && grep -Eq '^ksdk_synced=(true|unavailable)$' "$request_result" \
    && grep -Fqx 'cloud_synced=true' "$request_result" \
    && grep -Fqx 'cloud_snapshot_synced=true' "$request_result"; then
    # ReaderSDK mutations update the native annotation store. Explicitly hand
    # that store to Amazon's annotation sync client as the native reader does;
    # otherwise a direct agent mutation may remain local indefinitely.
    normalized_result="$request_result.normalized"
    if ! grep -v '^success=' "$request_result" >"$normalized_result"; then
        exit 8
    fi
    if [ -x "$LIPC_SET_PROP" ] \
        && "$LIPC_SET_PROP" "$ANNOTATION_CONTROLLER" "$ANNOTATION_ENQUEUE_PROPERTY" koreader \
            >/dev/null 2>&1 \
        && "$LIPC_SET_PROP" "$WHISPERSYNC_CONTROLLER" "$WHISPERSYNC_START_PROPERTY" koreader \
            >/dev/null 2>&1; then
        printf '%s\n' 'local_success=true' 'sync_enqueued=true' 'success=true' \
            >>"$normalized_result"
        enqueue_ok=1
    else
        printf '%s\n' 'local_success=true' 'sync_enqueued=false' 'success=false' \
            'failed_stage=native_sync_enqueue' >>"$normalized_result"
    fi
    if ! mv -f "$normalized_result" "$request_result"; then
        rm -f "$normalized_result"
        exit 8
    fi
fi

published_temp="$PUBLISHED_RESULT.$$"
if ! cp "$request_result" "$published_temp" || ! mv -f "$published_temp" "$PUBLISHED_RESULT"; then
    rm -f "$published_temp"
    exit 8
fi

if ! grep -Fqx 'success=true' "$request_result"; then
    exit 7
fi
if [ "$enqueue_ok" -ne 1 ]; then
    exit 10
fi

if ! mv -f "$state_temp" "$state_file"; then
    exit 8
fi
state_temp=""

exit 0
