#!/bin/sh

# Replay coalesced annotation snapshots when Kindle's native reader starts.
# One watcher serves every pending ASIN and exits when the queue is empty.

set -u

PLUGIN_DIR="${GOODREADS_PLUGIN_DIR:-/mnt/us/koreader/plugins/goodreads.koplugin}"
SYNC_HELPER="$PLUGIN_DIR/bin/sync-annotations"
SETTINGS_DIR="${GOODREADS_SETTINGS_DIR:-/mnt/us/koreader/settings}"
PRIVATE_STATE_DIR="${GOODREADS_PRIVATE_STATE_DIR:-/var/local/koreader-goodreads-native}"
PENDING_DIR="$PRIVATE_STATE_DIR/annotation-pending"
LEGACY_PENDING_DIR="$SETTINGS_DIR/goodreads_native_annotations_pending"
LOCK_ROOT="${GOODREADS_LOCK_DIR:-/tmp}"
WATCH_LOCK="$LOCK_ROOT/goodreads-annotation-watcher.lock"
LIPC_WAIT_EVENT="${GOODREADS_LIPC_WAIT_EVENT:-/usr/bin/lipc-wait-event}"
LIPC_GET_PROP="${GOODREADS_LIPC_GET_PROP:-/usr/bin/lipc-get-prop}"
DBUS_MONITOR="${GOODREADS_DBUS_MONITOR:-/usr/bin/dbus-monitor}"
TIMEOUT_BIN="${GOODREADS_TIMEOUT_BIN:-/usr/bin/timeout}"
USLEEP_BIN="${GOODREADS_USLEEP_BIN:-/bin/usleep}"
BOOK_LOCK_ROOT="$LOCK_ROOT"
TMP_ROOT="${GOODREADS_TMP_DIR:-/tmp}"

migrate_legacy_pending() {
    mkdir -p "$PENDING_DIR" || return 1
    chmod 0700 "$PRIVATE_STATE_DIR" "$PENDING_DIR" 2>/dev/null || true
    for legacy in "$LEGACY_PENDING_DIR"/B?????????; do
        [ -f "$legacy" ] || continue
        asin="$(basename "$legacy")"
        if [ -e "$PENDING_DIR/$asin" ]; then
            rm -f "$legacy"
            continue
        fi
        temp="$PENDING_DIR/$asin.migrate.$$"
        if cp "$legacy" "$temp" && chmod 0600 "$temp" \
            && mv -f "$temp" "$PENDING_DIR/$asin"; then
            rm -f "$legacy"
        else
            rm -f "$temp"
        fi
    done
}

migrate_legacy_pending || true

once_asin=""
if [ "$#" -eq 2 ] && [ "$1" = "--once" ] \
    && printf '%s\n' "$2" | grep -Eq '^B[A-Z0-9]{9}$'; then
    once_asin="$2"
elif [ "$#" -ne 0 ]; then
    exit 2
fi

if [ -z "$once_asin" ]; then
    if ! mkdir "$WATCH_LOCK" 2>/dev/null; then
        exit 0
    fi
    trap 'rmdir "$WATCH_LOCK" 2>/dev/null || true' EXIT HUP INT TERM
fi

replay_pending() {
    found=0
    for pending in "$PENDING_DIR"/B?????????; do
        [ -f "$pending" ] || continue
        found=1
        asin="$(basename "$pending")"
        if [ -n "$once_asin" ] && [ "$asin" != "$once_asin" ]; then
            continue
        fi
        book_lock="$BOOK_LOCK_ROOT/goodreads-annotation-book-$asin.lock"
        if ! mkdir "$book_lock" 2>/dev/null; then
            continue
        fi
        request_id="$(date +%s)$$"
        payload="$TMP_ROOT/goodreads-annotations-$request_id.properties"
        if ! awk -F= -v id="$request_id" '
            /^request_id=/ { print "request_id=" id; next }
            /^retry_count=/ {
                retry=$2 + 0
                if (retry < 999) retry++
                print "retry_count=" retry
                found_retry=1
                next
            }
            { print }
            END { if (!found_retry) print "retry_count=1" }
        ' "$pending" >"$payload"; then
            rm -f "$payload"
            rmdir "$book_lock" 2>/dev/null || true
            continue
        fi
        chmod 0600 "$payload"
        if "$SYNC_HELPER" "$payload"; then
            rm -f "$pending"
        fi
        rmdir "$book_lock" 2>/dev/null || true
    done
    return "$found"
}

pending_exists() {
    find "$PENDING_DIR" -maxdepth 1 -type f -name 'B?????????' 2>/dev/null \
        | grep -q .
}

replay_reader_start() {
    # appStarted is emitted just before this firmware releases ReaderSDK's
    # exact KFX handle. Give the SDK a brief settling window, then make at most
    # three closely bounded attempts. The exact ASIN/path checks remain inside
    # the native agent, so a cloud placeholder or different book fails closed.
    attempt=0
    while pending_exists && [ "$attempt" -lt 3 ]; do
        if [ -x "$USLEEP_BIN" ]; then
            "$USLEEP_BIN" 100000
        fi
        replay_pending || true
        attempt=$((attempt + 1))
    done
}

listen_for_reader_start() {
    [ -x "$DBUS_MONITOR" ] && [ -x "$TIMEOUT_BIN" ] || return 1
    awaiting_app_name=0
    "$TIMEOUT_BIN" 30 "$DBUS_MONITOR" --system \
        "type='signal',interface='com.lab126.appmgrd',member='appStarted'" \
        2>/dev/null | while IFS= read -r line; do
            case "$line" in
                *'interface=com.lab126.appmgrd; member=appStarted'*)
                    awaiting_app_name=1
                    ;;
                *'string "com.lab126.booklet.reader"'*)
                    if [ "$awaiting_app_name" -eq 1 ]; then
                        replay_reader_start
                        pending_exists || break
                    fi
                    awaiting_app_name=0
                    ;;
                signal*)
                    awaiting_app_name=0
                    ;;
            esac
        done
}

if [ -n "$once_asin" ]; then
    replay_pending || true
    exit 0
fi

# A pending snapshot may have been queued while the native book was already
# activating, so try once before blocking for the next application start.
replay_pending || true

# KPPMainApp remains resident on newer firmware, so LIPC appStarted can miss
# the short-lived ReaderSDK handle even though the system DBus appStarted
# signal is emitted. A filtered DBus listener sleeps in the kernel and wakes at
# the exact reader handoff; the bounded loop lets us notice external success or
# a monitor restart without polling the device continuously.
while pending_exists && [ -x "$DBUS_MONITOR" ] && [ -x "$TIMEOUT_BIN" ]; do
    listen_for_reader_start || true
done

last_active_app=""
active_attempts=0
while pending_exists; do
    event_seen=0
    if "$LIPC_WAIT_EVENT" -s 15 com.lab126.appmgrd appStarted >/dev/null 2>&1; then
        event_seen=1
    fi
    active_app=""
    if [ -x "$LIPC_GET_PROP" ]; then
        active_app="$(
            "$LIPC_GET_PROP" com.lab126.appmgrd activeApp 2>/dev/null \
                | sed -n '1p'
        )"
    fi
    if [ "$active_app" != "$last_active_app" ]; then
        active_attempts=0
    fi
    if [ "$active_app" = "com.lab126.booklet.reader" ] \
        && { [ "$event_seen" -eq 1 ] || [ "$active_attempts" -lt 3 ]; }; then
        replay_pending || true
        active_attempts=$((active_attempts + 1))
    fi
    last_active_app="$active_app"
done

exit 0
